# APAAR Nexus - Environment Variables (Example)
# Copy this file to .env for local development

# Flask Secret Key (change in production)
SECRET_KEY=dev-secret-key-change-in-production-12345

# Database Configuration
DATABASE_URL=sqlite:///instance/apaar_nexus.db

# Flask Environment (development / testing / production)
FLASK_ENV=development

# Demo User Password (development only, default: Demo@12345)
DEMO_PASSWORD=Demo@12345

# File Upload Limits
MAX_UPLOAD_MB=2
MAX_CSV_ROWS=5000

# Cryptographic Keys for Ed25519 Credentials
SIGNING_KEY_DIR=instance/keys

# Session Cookie Security
SESSION_COOKIE_SECURE=false

# Demo Reset Feature (allows resetting synthetic data from policies page)
ALLOW_DEMO_RESET=true
